{
  "name": "colflow",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "colflow": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "bun build src/cli.tsx --target=bun --outfile=dist/cli.js",
    "compile": "bun build src/cli.tsx --compile --outfile=dist/colflow",
    "check": "biome check --write && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@tqman/ink-table": "^0.0.0-development",
    "dotenv": "^17.4.2",
    "fullscreen-ink": "^0.1.0",
    "graphql-request": "^7.4.0",
    "hyparquet": "^1.25.8",
    "hyparquet-compressors": "^1.1.1",
    "ink": "^7.0.3",
    "meow": "^14.1.0",
    "react": "^19.2.6",
    "zod": "^4.4.3"
  }
}
